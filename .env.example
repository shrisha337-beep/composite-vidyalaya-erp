# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/composite_vidyalaya?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# SMS OTP provider (fill in once chosen — MSG91/Twilio/etc.)
SMS_API_KEY=""
SMS_SENDER_ID=""

# Field-level encryption key for Aadhaar/bank fields — generate with openssl rand -hex 32
ENCRYPTION_KEY=""

# Gemini API key — used for smart Excel import column mapping
GEMINI_API_KEY=""

# Demo & Seed Isolation Controls
# CAUTION: Never set ALLOW_SEED=true or DEMO_MODE=true in production.
ALLOW_SEED="false"
DEMO_MODE="false"
NEXT_PUBLIC_DEMO_MODE="false"
DEMO_ADMIN_PHONE="9000000000"
DEMO_ADMIN_PASSWORD="ReplaceWithStrongPassword123"
DEMO_TEACHER_PHONE="9000000001"
DEMO_TEACHER_PASSWORD="ReplaceWithStrongPassword123"
